<Application
    x:Class="ToolArchMilestone.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ToolArchMilestone.Converters"
    xmlns:local="using:ToolArchMilestone">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

             <!-- Converters -->
             <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
             <converters:DateTimeToDateTimeOffsetConverter x:Key="DateToOffset"/>

            <!-- Global Colors & Brushes -->
             <SolidColorBrush x:Key="WindowBackground" Color="#FF121212"/> <!-- Deep Background -->
             <SolidColorBrush x:Key="SurfaceBackground" Color="#FF1E1E1E"/> <!-- Card Background -->
             <SolidColorBrush x:Key="InputBackground" Color="#FF2C2C2C"/> <!-- Input Fields -->
             <SolidColorBrush x:Key="InputBorder" Color="#FF444444"/>

             <!-- Branding -->
             <SolidColorBrush x:Key="MilestoneBlue" Color="#00A3E0"/>
             <SolidColorBrush x:Key="MilestoneDarkBlue" Color="#0047BB"/>
             <SolidColorBrush x:Key="MilestoneYellow" Color="#FFD100"/>

             <!-- Text -->
             <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF"/>
             <SolidColorBrush x:Key="TextSecondary" Color="#FFB0B0B0"/>
             <SolidColorBrush x:Key="TextDisabled" Color="#FF666666"/>

             <!-- === COMPACT STYLES (User Request: "Meno altezza, meno spazio sprecato") === -->

             <!-- Compact Card -->
             <Style x:Key="MaterialCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBackground}"/>
                <Setter Property="BorderBrush" Value="#333333"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/> <!-- Reduced from 12 -->
                <Setter Property="Padding" Value="12"/> <!-- Reduced from 20 -->
                <Setter Property="Margin" Value="0,0,0,12"/>
             </Style>

             <!-- Compact TextBox -->
             <Style x:Key="MaterialTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource InputBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/> <!-- Reduced from 8 -->
                <Setter Property="MinHeight" Value="32"/> <!-- Reduced from 48 -->
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="8,5,8,4"/> <!-- Tight padding -->
                <Setter Property="PlaceholderForeground" Value="{StaticResource TextDisabled}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
             </Style>

             <!-- Compact Primary Button -->
             <Style x:Key="MaterialPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource MilestoneBlue}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="CornerRadius" Value="18"/> <!-- Reduced -->
                <Setter Property="Height" Value="36"/> <!-- Reduced from 48 -->
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="BorderThickness" Value="0"/>
             </Style>

             <!-- Compact Secondary Button -->
             <Style x:Key="MaterialSecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource MilestoneBlue}"/>
                <Setter Property="BorderBrush" Value="{StaticResource MilestoneBlue}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Height" Value="32"/> <!-- Reduced from 40 -->
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="12,0"/>
             </Style>

             <!-- Compact Icon Button -->
             <Style x:Key="MaterialIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="Width" Value="32"/> <!-- Reduced from 40 -->
                <Setter Property="Height" Value="32"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
             </Style>

             <!-- Headers -->
             <Style x:Key="MaterialHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource MilestoneBlue}"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="CharacterSpacing" Value="30"/>
             </Style>

             <!-- Input Label Style -->
             <Style x:Key="InputLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/> <!-- Smaller label -->
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="Margin" Value="2,0,0,2"/> <!-- Tighter margin -->
             </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
