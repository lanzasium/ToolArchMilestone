<Application
    x:Class="ToolArchMilestone.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ToolArchMilestone.Converters"
    xmlns:local="using:ToolArchMilestone">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

             <!-- Converters -->
             <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
             <converters:DateTimeToDateTimeOffsetConverter x:Key="DateToOffset"/>

            <!-- Global Colors & Brushes -->
             <SolidColorBrush x:Key="WindowBackground" Color="#FF121212"/> <!-- Deep Background -->
             <SolidColorBrush x:Key="SurfaceBackground" Color="#FF1E1E1E"/> <!-- Card Background -->
             <SolidColorBrush x:Key="InputBackground" Color="#FF2C2C2C"/> <!-- Input Fields -->
             <SolidColorBrush x:Key="InputBorder" Color="#FF444444"/>

             <!-- Branding -->
             <SolidColorBrush x:Key="MilestoneBlue" Color="#00A3E0"/>
             <SolidColorBrush x:Key="MilestoneDarkBlue" Color="#0047BB"/>
             <SolidColorBrush x:Key="MilestoneYellow" Color="#FFD100"/>

             <!-- Text -->
             <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF"/>
             <SolidColorBrush x:Key="TextSecondary" Color="#FFB0B0B0"/>
             <SolidColorBrush x:Key="TextDisabled" Color="#FF666666"/>

             <!-- === MATERIAL 3 INSPIRED STYLES === -->

             <!-- Material Card -->
             <Style x:Key="MaterialCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBackground}"/>
                <Setter Property="BorderBrush" Value="#333333"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
             </Style>

             <!-- Material TextBox -->
             <Style x:Key="MaterialTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource InputBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="MinHeight" Value="48"/> <!-- Taller touch target -->
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="12,10,12,8"/>
                <Setter Property="PlaceholderForeground" Value="{StaticResource TextDisabled}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <!-- WinUI Focus Visuals would need retemplating for perfect Material,
                     but standard properties get us 90% there -->
             </Style>

             <!-- Material Primary Button (Filled) -->
             <Style x:Key="MaterialPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource MilestoneBlue}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="CornerRadius" Value="24"/> <!-- Full Pill -->
                <Setter Property="Height" Value="48"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="24,0"/>
                <Setter Property="BorderThickness" Value="0"/>
             </Style>

             <!-- Material Secondary Button (Outlined/Tonal) -->
             <Style x:Key="MaterialSecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource MilestoneBlue}"/>
                <Setter Property="BorderBrush" Value="{StaticResource MilestoneBlue}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="20"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="16,0"/>
             </Style>

             <!-- Material Icon Button (Circular) -->
             <Style x:Key="MaterialIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="CornerRadius" Value="20"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
             </Style>

             <!-- Headers -->
             <Style x:Key="MaterialHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource MilestoneBlue}"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="CharacterSpacing" Value="50"/>
             </Style>

             <!-- Input Label Style (for consistent text above inputs) -->
             <Style x:Key="InputLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="Margin" Value="4,0,0,4"/>
             </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
