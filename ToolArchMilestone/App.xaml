<Application
    x:Class="ToolArchMilestone.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ToolArchMilestone.Converters"
    xmlns:local="using:ToolArchMilestone">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other dictionaries -->
            </ResourceDictionary.MergedDictionaries>

             <!-- Converters -->
             <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
             <converters:DateTimeToDateTimeOffsetConverter x:Key="DateToOffset"/>

            <!-- Global Styles -->
             <SolidColorBrush x:Key="WindowBackground" Color="#FF121212"/> <!-- Deep Dark -->

             <!-- Colors (Defined for Animation Access) -->
             <Color x:Key="MilestoneBlueColor">#00A3E0</Color>
             <Color x:Key="MilestoneDarkBlueColor">#0047BB</Color>
             <Color x:Key="MilestoneYellowColor">#FFD100</Color>
             <Color x:Key="CardBackgroundColor">#FF1E1E1E</Color>

             <!-- Brushes -->
             <SolidColorBrush x:Key="MilestoneBlue" Color="{StaticResource MilestoneBlueColor}"/>
             <SolidColorBrush x:Key="MilestoneDarkBlue" Color="{StaticResource MilestoneDarkBlueColor}"/>
             <SolidColorBrush x:Key="MilestoneYellow" Color="{StaticResource MilestoneYellowColor}"/>
             <SolidColorBrush x:Key="CardBackground" Color="{StaticResource CardBackgroundColor}"/>
             <SolidColorBrush x:Key="CardBorder" Color="#FF333333"/>
             <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF"/>
             <SolidColorBrush x:Key="TextSecondary" Color="#FFB0B0B0"/>

             <!-- Base Card Style (Material 3 Inspired) -->
             <Style x:Key="MilestoneCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
             </Style>

             <!-- Header Text Style -->
             <Style x:Key="MilestoneHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource MilestoneBlue}"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
             </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
