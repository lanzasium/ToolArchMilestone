<Application
    x:Class="ToolArchMilestone.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ToolArchMilestone">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other dictionaries -->
            </ResourceDictionary.MergedDictionaries>
            <!-- Global Styles -->
             <SolidColorBrush x:Key="WindowBackground" Color="#FF121212"/> <!-- Deep Dark -->

             <!-- Milestone Inspired Colors -->
             <SolidColorBrush x:Key="MilestoneBlue" Color="#00A3E0"/> <!-- Clear Blue -->
             <SolidColorBrush x:Key="MilestoneDarkBlue" Color="#0047BB"/> <!-- Dark Blue -->
             <SolidColorBrush x:Key="MilestoneYellow" Color="#FFD100"/> <!-- Yellow -->
             <SolidColorBrush x:Key="CardBackground" Color="#FF1E1E1E"/> <!-- Surface Dark -->
             <SolidColorBrush x:Key="CardBorder" Color="#FF333333"/>
             <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF"/>
             <SolidColorBrush x:Key="TextSecondary" Color="#FFB0B0B0"/>

             <!-- Base Card Style -->
             <Style x:Key="MilestoneCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
             </Style>

             <!-- Header Text Style -->
             <Style x:Key="MilestoneHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource MilestoneBlue}"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
             </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
