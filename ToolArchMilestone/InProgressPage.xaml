<Page
    x:Name="RootPage"
    x:Class="ToolArchMilestone.InProgressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:core="using:ToolArchMilestone.Core.Models"
    mc:Ignorable="d">

    <Grid Padding="32" Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="4" Margin="0,0,0,24">
            <TextBlock Text="ARCHIVIAZIONI IN CORSO" FontSize="28" FontWeight="Bold" Foreground="White" CharacterSpacing="50"/>
            <TextBlock Text="Gestione della coda di esportazione" FontSize="14" Foreground="{StaticResource TextSecondary}"/>
        </StackPanel>

        <!-- Search Bar -->
        <TextBox Grid.Row="1"
                 Style="{StaticResource MaterialTextBoxStyle}"
                 PlaceholderText="Cerca per ID Job, ID Lavoro, Camera..."
                 Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,24"/>

        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Jobs, Mode=OneWay}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="core:ArchivingJob">
                    <Border Style="{StaticResource MaterialCardStyle}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Job Info -->
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <!-- Status Chip -->
                                    <Border Background="#22FFFFFF" CornerRadius="12" Padding="8,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource MilestoneYellow}"/>
                                            <TextBlock Text="{x:Bind Status}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- ID Badge -->
                                    <Border Background="{StaticResource MilestoneBlue}" CornerRadius="12" Padding="8,4">
                                        <TextBlock Text="{x:Bind Id}" FontWeight="Bold" Foreground="White" FontSize="12"/>
                                    </Border>

                                    <TextBlock Text="{x:Bind CameraName}" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>

                                <TextBlock Text="{x:Bind WorkId}" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="4,0,0,0"/>
                            </StackPanel>

                            <!-- Controls -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                 <Button Content="Dettagli" Style="{StaticResource MaterialSecondaryButtonStyle}" Height="32" FontSize="12">
                                     <Button.Flyout>
                                         <Flyout>
                                             <StackPanel Width="320" Spacing="8">
                                                 <TextBlock Text="DETTAGLI JOB" Style="{StaticResource MaterialHeaderStyle}"/>
                                                 <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                                                     <TextBlock Text="ID Lavoro:" Foreground="Gray"/> <TextBlock Grid.Column="1" Text="{x:Bind WorkId}" Margin="8,0,0,0"/>
                                                     <TextBlock Grid.Row="1" Text="Proc.:" Foreground="Gray"/> <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind CriminalProceeding}" Margin="8,0,0,0"/>
                                                     <TextBlock Grid.Row="2" Text="Magistrato:" Foreground="Gray"/> <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind Magistrate}" Margin="8,0,0,0"/>
                                                     <TextBlock Grid.Row="3" Text="RIT/SPEC:" Foreground="Gray"/> <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind RitSpec}" Margin="8,0,0,0"/>
                                                     <TextBlock Grid.Row="4" Text="Target:" Foreground="Gray"/> <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind Target}" Margin="8,0,0,0"/>
                                                 </Grid>

                                                 <TextBlock Text="LOG DI SISTEMA" Style="{StaticResource MaterialHeaderStyle}" Margin="0,12,0,0" FontSize="12"/>
                                                 <ListView ItemsSource="{x:Bind Logs}" Height="150">
                                                     <ListView.ItemTemplate>
                                                         <DataTemplate>
                                                             <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap" Foreground="White"/>
                                                         </DataTemplate>
                                                     </ListView.ItemTemplate>
                                                 </ListView>
                                             </StackPanel>
                                         </Flyout>
                                     </Button.Flyout>
                                 </Button>

                                 <Button Content="Stop" Background="#E53935" Foreground="White" Padding="12,0" Height="32" CornerRadius="16" FontSize="12" Command="{Binding ElementName=RootPage, Path=ViewModel.StopJobCommand}" CommandParameter="{x:Bind Id}"/>

                                 <StackPanel Orientation="Horizontal" Spacing="2">
                                     <Button Style="{StaticResource MaterialIconButtonStyle}" Width="32" Height="32" Command="{Binding ElementName=RootPage, Path=ViewModel.MoveUpCommand}" CommandParameter="{x:Bind Id}">
                                        <FontIcon Glyph="&#xE70E;" FontSize="12"/> <!-- Up Arrow -->
                                     </Button>
                                     <Button Style="{StaticResource MaterialIconButtonStyle}" Width="32" Height="32" Command="{Binding ElementName=RootPage, Path=ViewModel.MoveDownCommand}" CommandParameter="{x:Bind Id}">
                                        <FontIcon Glyph="&#xE70D;" FontSize="12"/> <!-- Down Arrow -->
                                     </Button>
                                 </StackPanel>
                            </StackPanel>

                            <!-- Progress -->
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{x:Bind Progress, Mode=OneWay}" Margin="0,16" Height="6" Foreground="{StaticResource MilestoneBlue}"/>

                            <!-- Error -->
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Bind ErrorMessage, Mode=OneWay}" Foreground="#EF5350" TextWrapping="Wrap" FontSize="12" Visibility="{x:Bind ErrorMessage, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
