<Page
    x:Class="ToolArchMilestone.LaunchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ToolArchMilestone.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:DateTimeToDateTimeOffsetConverter x:Key="DateToOffset"/>

        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <!-- Shadow effect requires ThemeShadow in parent grid usually, or just stick to border for now -->
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="20">
        <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Main Content -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- LEFT COLUMN: SORGENTE & FORMATO -->
            <StackPanel Grid.Column="0">
                <!-- SORGENTE CARD -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Sorgente &amp; Formato" Style="{StaticResource SectionHeaderStyle}"/>

                        <!-- Type Selection (Chips/Toggle look) -->
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" Content="Legale" IsChecked="True" GroupName="Type" HorizontalAlignment="Stretch" Style="{StaticResource ToggleButtonStyle}"/>
                            <RadioButton Grid.Column="1" Content="Digitale" GroupName="Type" HorizontalAlignment="Stretch" Style="{StaticResource ToggleButtonStyle}"/>
                        </Grid>

                        <!-- Source Selection -->
                        <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,5,0,0">
                            <RadioButton Content="Da Server" IsChecked="{x:Bind ViewModel.IsServer, Mode=OneWay}" GroupName="Source" />
                            <RadioButton Content="Da Archivio" IsChecked="{x:Bind ViewModel.IsArchive, Mode=OneWay}" GroupName="Source" />
                        </StackPanel>

                        <!-- Server Input -->
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8" Visibility="{x:Bind ViewModel.IsServer, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBox Header="Indirizzo Server" Text="{x:Bind ViewModel.ServerAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="es. 192.168.1.100"/>
                            <Button Content="Connetti" VerticalAlignment="Bottom" Grid.Column="1"/>
                        </Grid>

                        <!-- Camera Input -->
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8" Visibility="{x:Bind ViewModel.IsServer, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBox Header="Telecamera" Text="{x:Bind ViewModel.CameraName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" PlaceholderText="Seleziona camera..."/>
                            <Button Content="Seleziona" VerticalAlignment="Bottom" Grid.Column="1"/>
                        </Grid>

                        <!-- Intervals -->
                        <TextBlock Text="Intervallo Temporale" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                            <CalendarDatePicker Header="Inizio" Date="{x:Bind ViewModel.StartTime, Mode=TwoWay, Converter={StaticResource DateToOffset}}" HorizontalAlignment="Stretch"/>
                            <CalendarDatePicker Header="Fine" Grid.Column="1" Date="{x:Bind ViewModel.EndTime, Mode=TwoWay, Converter={StaticResource DateToOffset}}" HorizontalAlignment="Stretch"/>
                        </Grid>

                        <!-- Drop Area -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="DropArea" BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="1" CornerRadius="4" Padding="15" AllowDrop="True" DragOver="DropArea_DragOver" Drop="DropArea_Drop" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                                    <SymbolIcon Symbol="Upload" Foreground="Gray"/>
                                    <TextBlock Text="Trascina qui il file TXT" Foreground="Gray"/>
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="1" Content="X" Margin="8,0,0,0" VerticalAlignment="Stretch" Background="Transparent" Foreground="Red"/>
                        </Grid>

                        <CheckBox Content="Archiviazione separata per intervallo" IsChecked="{x:Bind ViewModel.SeparateArchive, Mode=TwoWay}"/>

                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- RIGHT COLUMN: CONFIGURAZIONE -->
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Configurazione Procedura" Style="{StaticResource SectionHeaderStyle}"/>

                        <TextBox Header="Procedimento Penale" Text="{x:Bind ViewModel.CriminalProceeding, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="es. 12345/2023"/>
                        <TextBox Header="Magistrato" Text="{x:Bind ViewModel.Magistrate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Header="RIT/SPEC" Text="{x:Bind ViewModel.RitSpec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Header="ID Lavoro (RCS)" Text="{x:Bind ViewModel.WorkId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Header="Target" Text="{x:Bind ViewModel.Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                            <PasswordBox Header="Password" Password="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="Genera" VerticalAlignment="Bottom" Grid.Column="1" Command="{x:Bind ViewModel.GeneratePasswordCommand}"/>
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                            <TextBox Header="Cartella Esportazione" Text="{x:Bind ViewModel.ExportPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="Sfoglia" VerticalAlignment="Bottom" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- FOOTER ACTION -->
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,20,0,0">
                <Button Command="{x:Bind ViewModel.LaunchCommand}" HorizontalAlignment="Stretch" Height="50" CornerRadius="25">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <SymbolIcon Symbol="Play"/>
                        <TextBlock Text="AVVIA ARCHIVIAZIONE" FontWeight="Bold" FontSize="16"/>
                    </StackPanel>
                    <Button.Background>
                        <SolidColorBrush Color="#FF0078D7"/>
                    </Button.Background>
                    <Button.Foreground>
                        <SolidColorBrush Color="White"/>
                    </Button.Foreground>
                </Button>
            </Grid>

        </Grid>
    </ScrollViewer>
</Page>
