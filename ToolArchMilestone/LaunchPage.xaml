<Page
    x:Class="ToolArchMilestone.LaunchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ToolArchMilestone.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Tab Style Toggle (Text + Bottom Indicator) -->
        <Style x:Key="TabToggleStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="White"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MilestoneBlue}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#99FFFFFF"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <StackPanel>
                                <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <Rectangle x:Name="Indicator" Height="3" Fill="{StaticResource MilestoneBlue}" RadiusX="1.5" RadiusY="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform ScaleX="0"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Padding="24" Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Google-Style Header -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Title -->
                <ColumnDefinition Width="*"/>    <!-- Spacer -->
                <ColumnDefinition Width="Auto"/> <!-- Tabs -->
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="2">
                <TextBlock Text="NUOVA ARCHIVIAZIONE" FontSize="22" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Configurazione parametri" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>

            <!-- Tab Navigation Island -->
            <Border Grid.Column="2" Background="#1E1E1E" CornerRadius="8" Padding="4" BorderBrush="#333" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- Format Group -->
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="LEGALE" IsChecked="True" GroupName="Type" Style="{StaticResource TabToggleStyle}"/>
                        <RadioButton Content="DIGITALE" GroupName="Type" Style="{StaticResource TabToggleStyle}"/>
                    </StackPanel>

                    <Rectangle Width="1" Fill="#333" Margin="8,4"/>

                    <!-- Source Group -->
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="SERVER" IsChecked="{x:Bind ViewModel.IsServer, Mode=OneWay}" GroupName="Source" Style="{StaticResource TabToggleStyle}"/>
                        <RadioButton Content="ARCHIVIO" IsChecked="{x:Bind ViewModel.IsArchive, Mode=OneWay}" GroupName="Source" Style="{StaticResource TabToggleStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="24">

                <!-- SORGENTE CARD -->
                <Border Style="{StaticResource MilestoneCardStyle}">
                    <Grid>
                        <!-- Left Accent Line -->
                        <Rectangle Width="4" HorizontalAlignment="Left" Fill="{StaticResource MilestoneBlue}" RadiusX="2" RadiusY="2"/>

                        <StackPanel Spacing="16" Margin="12,0,0,0">
                            <TextBlock Text="SORGENTE" Style="{StaticResource MilestoneHeaderStyle}" Margin="0"/>

                            <!-- Server & Camera -->
                            <Grid ColumnSpacing="16" Visibility="{x:Bind ViewModel.IsServer, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <TextBox Header="Indirizzo Server" Text="{x:Bind ViewModel.ServerAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="es. 192.168.1.100" CornerRadius="4"/>
                                    <Button Content="Connetti" VerticalAlignment="Bottom" Grid.Column="1"/>
                                    <Button Content="📌" VerticalAlignment="Bottom" Grid.Column="2" Background="Transparent" Command="{x:Bind ViewModel.PinFieldCommand}" CommandParameter="ServerAddress"/>
                                </Grid>

                                <Grid Grid.Column="1" ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8">
                                    <TextBox Header="Telecamera" Text="{x:Bind ViewModel.CameraName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" PlaceholderText="Nessuna selezione..." CornerRadius="4"/>
                                    <Button Content="Seleziona" VerticalAlignment="Bottom" Grid.Column="1"/>
                                    <Button Content="📌" VerticalAlignment="Bottom" Grid.Column="2" Background="Transparent" Command="{x:Bind ViewModel.PinFieldCommand}" CommandParameter="CameraName"/>
                                </Grid>
                            </Grid>

                            <!-- Smart Interval Input -->
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/> <!-- Start -->
                                    <ColumnDefinition Width="*"/> <!-- End -->
                                    <ColumnDefinition Width="Auto"/> <!-- Drop -->
                                </Grid.ColumnDefinitions>

                                <!-- Start Smart Field -->
                                <Grid Grid.Column="0" ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <TextBox Header="Inizio (dd/MM/yyyy HH:mm)" Text="{x:Bind ViewModel.StartDateString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Incolla o seleziona..." IsEnabled="{x:Bind ViewModel.IsManualIntervalEnabled, Mode=OneWay}"/>
                                    <Button VerticalAlignment="Bottom" Background="Transparent" Padding="4" ToolTipService.ToolTip="Seleziona Data/Ora">
                                        <SymbolIcon Symbol="Calendar" Foreground="{StaticResource MilestoneBlue}"/>
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel Spacing="8">
                                                    <CalendarDatePicker DateChanged="StartPicker_DateChanged" Date="{x:Bind ViewModel.StartTime, Mode=TwoWay, Converter={StaticResource DateToOffset}}"/>
                                                    <TimePicker TimeChanged="StartTime_TimeChanged" SelectedTime="{x:Bind ViewModel.StartTimeTime, Mode=TwoWay}" ClockIdentifier="24HourClock"/>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>

                                <!-- End Smart Field -->
                                <Grid Grid.Column="1" ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <TextBox Header="Fine (dd/MM/yyyy HH:mm)" Text="{x:Bind ViewModel.EndDateString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Incolla o seleziona..." IsEnabled="{x:Bind ViewModel.IsManualIntervalEnabled, Mode=OneWay}"/>
                                    <Button VerticalAlignment="Bottom" Background="Transparent" Padding="4" ToolTipService.ToolTip="Seleziona Data/Ora">
                                        <SymbolIcon Symbol="Calendar" Foreground="{StaticResource MilestoneBlue}"/>
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel Spacing="8">
                                                    <CalendarDatePicker DateChanged="EndPicker_DateChanged" Date="{x:Bind ViewModel.EndTime, Mode=TwoWay, Converter={StaticResource DateToOffset}}"/>
                                                    <TimePicker TimeChanged="EndTime_TimeChanged" SelectedTime="{x:Bind ViewModel.EndTimeTime, Mode=TwoWay}" ClockIdentifier="24HourClock"/>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>

                                <!-- Drop Area (Icon Button Style) -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="8" Margin="0,0,0,4">
                                    <Border Width="40" Height="32" CornerRadius="4" BorderBrush="#666" BorderThickness="1" AllowDrop="True" DragOver="DropArea_DragOver" Drop="DropArea_Drop" Background="#222">
                                        <SymbolIcon Symbol="Import" Foreground="{StaticResource MilestoneBlue}"/>
                                    </Border>
                                    <Button Content="Apri TXT" Command="{x:Bind ViewModel.ImportIntervalsFromFileCommand}" Height="32" Padding="8,4" FontSize="12"/>

                                    <StackPanel Orientation="Horizontal" Visibility="{x:Bind ViewModel.IsFileImported, Mode=OneWay, Converter={StaticResource BoolToVis}}" Spacing="4">
                                        <TextBlock Text="{x:Bind ViewModel.ImportedFileName, Mode=OneWay}" VerticalAlignment="Center" Foreground="#00FF00" FontSize="12" FontWeight="Bold" MaxWidth="100" TextTrimming="CharacterEllipsis"/>
                                        <Button Background="Transparent" Padding="4" Command="{x:Bind ViewModel.RemoveImportedFileCommand}">
                                            <SymbolIcon Symbol="Cancel" Foreground="#FF5555"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <CheckBox Content="Separa archiviazioni" IsChecked="{x:Bind ViewModel.SeparateArchive, Mode=TwoWay}" FontSize="12" Margin="0,-8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- DATI PROCEDURA -->
                <Border Style="{StaticResource MilestoneCardStyle}">
                    <Grid>
                        <!-- Left Accent Line -->
                        <Rectangle Width="4" HorizontalAlignment="Left" Fill="{StaticResource MilestoneYellow}" RadiusX="2" RadiusY="2"/>

                        <StackPanel Spacing="16" Margin="12,0,0,0">
                            <TextBlock Text="DATI PROCEDURA" Style="{StaticResource MilestoneHeaderStyle}" Foreground="{StaticResource MilestoneYellow}" Margin="0"/>

                            <!-- Row 1 -->
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Header="Procedimento Penale" Text="{x:Bind ViewModel.CriminalProceeding, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="es. 12345/2023"/>
                                <TextBox Grid.Column="1" Header="Magistrato" Text="{x:Bind ViewModel.Magistrate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- Row 2 -->
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Header="RIT/SPEC" Text="{x:Bind ViewModel.RitSpec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Column="1" Header="ID Lavoro (RCS)" Text="{x:Bind ViewModel.WorkId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- Row 3 -->
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Header="Target" Text="{x:Bind ViewModel.Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <Grid Grid.Column="1" ColumnDefinitions="*, Auto" ColumnSpacing="4">
                                    <PasswordBox Header="Password" Password="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Content="Genera" VerticalAlignment="Bottom" Grid.Column="1" Command="{x:Bind ViewModel.GeneratePasswordCommand}"/>
                                    <Button Content="📌" VerticalAlignment="Bottom" Grid.Column="2" Background="Transparent" Command="{x:Bind ViewModel.PinFieldCommand}" CommandParameter="Password"/>
                                </Grid>
                            </Grid>

                            <!-- Row 4 -->
                            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="4">
                                <TextBox Header="Cartella Esportazione" Text="{x:Bind ViewModel.ExportPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Content="Sfoglia" VerticalAlignment="Bottom" Grid.Column="1"/>
                                <Button Content="📌" VerticalAlignment="Bottom" Grid.Column="2" Background="Transparent" Command="{x:Bind ViewModel.PinFieldCommand}" CommandParameter="ExportPath"/>
                            </Grid>

                        </StackPanel>
                    </Grid>
                </Border>

                <!-- FOOTER ACTION -->
                <Button Command="{x:Bind ViewModel.LaunchCommand}"
                        Background="{StaticResource MilestoneBlue}" Foreground="White"
                        HorizontalAlignment="Stretch" Height="50" CornerRadius="8" FontSize="16" FontWeight="Bold"
                        Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <SymbolIcon Symbol="Play"/>
                        <TextBlock Text="AVVIA ARCHIVIAZIONE"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
