<Page
    x:Class="ToolArchMilestone.LaunchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ToolArchMilestone.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:DateTimeToDateTimeOffsetConverter x:Key="DateToOffset"/>
    </Page.Resources>

    <Grid Padding="24" Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header & Action -->
            <RowDefinition Height="*"/>    <!-- Content -->
        </Grid.RowDefinitions>

        <!-- HEADER AREA -->
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="NUOVA ARCHIVIAZIONE" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Configura i parametri e avvia il processo" FontSize="14" Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>

            <!-- PRIMARY ACTION BUTTON (Top Right) -->
            <Button Grid.Column="1" Command="{x:Bind ViewModel.LaunchCommand}"
                    Background="{StaticResource MilestoneBlue}" Foreground="White"
                    CornerRadius="20" Height="44" Padding="24,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Play"/>
                    <TextBlock Text="AVVIA" FontWeight="Bold"/>
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: SORGENTE & FORMATO -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource MilestoneCardStyle}">
                        <!-- Override top border with an inner accent strip or just use the style as is.
                             The error was "Duplicate assignment to BorderBrush".
                             Style sets BorderBrush, and the tag set it again. This is valid in XAML usually,
                             but to be safe and cleaner, let's avoid the duplicate attribute if it causes issues
                             or define a specific style for Blue/Yellow borders.
                             For now, I'll remove the explicit BorderBrush/Thickness and rely on the style,
                             adding a Rectangle for the top accent instead. -->
                        <Grid>
                            <Rectangle Height="2" VerticalAlignment="Top" Fill="{StaticResource MilestoneBlue}" Margin="0,-16,0,0"/> <!-- Adjusted for padding -->
                            <!-- Actually easier: Remove explicit BorderBrush from the tag and let Style handle it,
                                 or if we want the top colored border, create a specific style or use a different element.
                                 Let's keep it simple: Use the Style, and remove the conflicting attributes. -->
                            <StackPanel Spacing="12">
                                <TextBlock Text="FORMATO &amp; SORGENTE" Style="{StaticResource MilestoneHeaderStyle}"/>

                            <!-- Chips -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0" Content="Legale" IsChecked="True" GroupName="Type" HorizontalAlignment="Stretch"/>
                                <RadioButton Grid.Column="1" Content="Digitale" GroupName="Type" HorizontalAlignment="Stretch"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4">
                                <RadioButton Content="Da Server" IsChecked="{x:Bind ViewModel.IsServer, Mode=OneWay}" GroupName="Source" Foreground="White" />
                                <RadioButton Content="Da Archivio" IsChecked="{x:Bind ViewModel.IsArchive, Mode=OneWay}" GroupName="Source" Foreground="White" />
                            </StackPanel>

                            <!-- Server Fields -->
                            <StackPanel Visibility="{x:Bind ViewModel.IsServer, Mode=OneWay, Converter={StaticResource BoolToVis}}" Spacing="12">
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <TextBox Header="Indirizzo Server" Text="{x:Bind ViewModel.ServerAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="es. 192.168.1.100"/>
                                    <Button Content="Connetti" VerticalAlignment="Bottom" Grid.Column="1"/>
                                </Grid>

                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <TextBox Header="Telecamera" Text="{x:Bind ViewModel.CameraName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" PlaceholderText="Seleziona camera..."/>
                                    <Button Content="Seleziona" VerticalAlignment="Bottom" Grid.Column="1"/>
                                </Grid>

                                <!-- Time -->
                                <TextBlock Text="Intervallo Temporale" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,0"/>
                                <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                                    <CalendarDatePicker Date="{x:Bind ViewModel.StartTime, Mode=TwoWay, Converter={StaticResource DateToOffset}}" HorizontalAlignment="Stretch"/>
                                    <CalendarDatePicker Grid.Column="1" Date="{x:Bind ViewModel.EndTime, Mode=TwoWay, Converter={StaticResource DateToOffset}}" HorizontalAlignment="Stretch"/>
                                </Grid>
                            </StackPanel>

                            <!-- Drop Area -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="DropArea" BorderBrush="{StaticResource TextSecondary}" BorderThickness="1" CornerRadius="6" Padding="12" AllowDrop="True" DragOver="DropArea_DragOver" Drop="DropArea_Drop" Background="Transparent">
                                    <Border.BorderBrush>
                                        <SolidColorBrush Color="{StaticResource TextSecondary}" Opacity="0.5"/>
                                    </Border.BorderBrush>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                        <SymbolIcon Symbol="Import" Foreground="{StaticResource MilestoneBlue}"/>
                                        <TextBlock Text="Importa TXT Intervalli" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                                <Button Grid.Column="1" Content="X" Margin="8,0,0,0" VerticalAlignment="Stretch" Background="Transparent" Foreground="#E00000"/>
                            </Grid>

                            <CheckBox Content="Separa archiviazioni" IsChecked="{x:Bind ViewModel.SeparateArchive, Mode=TwoWay}" Foreground="{StaticResource TextSecondary}"/>

                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- RIGHT COLUMN: CONFIGURAZIONE -->
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource MilestoneCardStyle}">
                        <Grid>
                            <Rectangle Height="2" VerticalAlignment="Top" Fill="{StaticResource MilestoneYellow}" Margin="0,-16,0,0"/>
                            <StackPanel Spacing="12">
                                <TextBlock Text="DATI PROCEDURA" Style="{StaticResource MilestoneHeaderStyle}" Foreground="{StaticResource MilestoneYellow}"/>

                            <TextBox Header="Procedimento Penale" Text="{x:Bind ViewModel.CriminalProceeding, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="es. 12345/2023"/>
                            <TextBox Header="Magistrato" Text="{x:Bind ViewModel.Magistrate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Header="RIT/SPEC" Text="{x:Bind ViewModel.RitSpec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Header="ID Lavoro (RCS)" Text="{x:Bind ViewModel.WorkId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Header="Target" Text="{x:Bind ViewModel.Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                <PasswordBox Header="Password" Password="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Content="Genera" VerticalAlignment="Bottom" Grid.Column="1" Command="{x:Bind ViewModel.GeneratePasswordCommand}"/>
                            </Grid>

                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                <TextBox Header="Cartella Esportazione" Text="{x:Bind ViewModel.ExportPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Content="Sfoglia" VerticalAlignment="Bottom" Grid.Column="1"/>
                            </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
