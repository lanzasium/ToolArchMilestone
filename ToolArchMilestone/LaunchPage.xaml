<Page
    x:Class="ToolArchMilestone.LaunchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ToolArchMilestone.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:DateTimeToDateTimeOffsetConverter x:Key="DateToOffset"/>

        <!-- Segmented Radio Button Style -->
        <Style x:Key="SegmentedRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{ThemeResource TextControlForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="RootBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#20FFFFFF" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="{StaticResource SystemAccentColor}" Duration="0"/>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="White"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Padding="24" Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="NUOVA ARCHIVIAZIONE" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,24"/>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="24">

                <!-- TOP SECTION: FORMATO & SORGENTE -->
                <Border Style="{StaticResource MilestoneCardStyle}">
                    <Grid>
                        <Rectangle Height="2" VerticalAlignment="Top" Fill="{StaticResource MilestoneBlue}" Margin="0,-16,0,0"/>
                        <StackPanel Spacing="20">
                            <TextBlock Text="FORMATO &amp; SORGENTE" Style="{StaticResource MilestoneHeaderStyle}"/>

                            <!-- Toggle Selectors (Row 1) -->
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Format Toggle -->
                                <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="4">
                                    <Grid ColumnDefinitions="*,*">
                                        <RadioButton Grid.Column="0" Content="Legale" IsChecked="True" GroupName="Type" Style="{StaticResource SegmentedRadioButtonStyle}"/>
                                        <RadioButton Grid.Column="1" Content="Digitale" GroupName="Type" Style="{StaticResource SegmentedRadioButtonStyle}"/>
                                    </Grid>
                                </Border>

                                <!-- Source Toggle -->
                                <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="4">
                                    <Grid ColumnDefinitions="*,*">
                                        <RadioButton Grid.Column="0" Content="Da Server" IsChecked="{x:Bind ViewModel.IsServer, Mode=OneWay}" GroupName="Source" Style="{StaticResource SegmentedRadioButtonStyle}"/>
                                        <RadioButton Grid.Column="1" Content="Da Archivio" IsChecked="{x:Bind ViewModel.IsArchive, Mode=OneWay}" GroupName="Source" Style="{StaticResource SegmentedRadioButtonStyle}"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Server & Camera (Row 2) - Visible only if Server -->
                            <Grid ColumnSpacing="20" Visibility="{x:Bind ViewModel.IsServer, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <TextBox Header="Indirizzo Server" Text="{x:Bind ViewModel.ServerAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="http://..."/>
                                    <Button Content="Connetti" VerticalAlignment="Bottom" Grid.Column="1"/>
                                </Grid>

                                <Grid Grid.Column="1" ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <TextBox Header="Telecamera" Text="{x:Bind ViewModel.CameraName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" PlaceholderText="Seleziona..."/>
                                    <Button Content="Seleziona" VerticalAlignment="Bottom" Grid.Column="1"/>
                                </Grid>
                            </Grid>

                            <!-- Interval & Import (Row 3) -->
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Date Inputs -->
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Intervallo Temporale" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                        <CalendarDatePicker Date="{x:Bind ViewModel.StartTime, Mode=TwoWay, Converter={StaticResource DateToOffset}}" HorizontalAlignment="Stretch"/>
                                        <CalendarDatePicker Grid.Column="1" Date="{x:Bind ViewModel.EndTime, Mode=TwoWay, Converter={StaticResource DateToOffset}}" HorizontalAlignment="Stretch"/>
                                    </Grid>
                                    <CheckBox Content="Separa archiviazioni per intervallo" IsChecked="{x:Bind ViewModel.SeparateArchive, Mode=TwoWay}" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Drop Area -->
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="DropArea" BorderBrush="{StaticResource TextSecondary}" BorderThickness="1,1,1,1" CornerRadius="6" AllowDrop="True" DragOver="DropArea_DragOver" Drop="DropArea_Drop" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                                        <Grid Padding="10">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                                <SymbolIcon Symbol="Import" Foreground="{StaticResource MilestoneBlue}"/>
                                                <TextBlock Text="Trascina TXT o Clicca" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0" Command="{x:Bind ViewModel.ImportIntervalsFromFileCommand}"/>
                                        </Grid>
                                    </Border>
                                    <Button Grid.Column="1" Content="X" Margin="8,0,0,0" VerticalAlignment="Center" Background="Transparent" Foreground="#E00000"/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- BOTTOM SECTION: DATI PROCEDURA -->
                <Border Style="{StaticResource MilestoneCardStyle}">
                    <Grid>
                        <Rectangle Height="2" VerticalAlignment="Top" Fill="{StaticResource MilestoneYellow}" Margin="0,-16,0,0"/>
                        <StackPanel Spacing="20">
                            <TextBlock Text="DATI PROCEDURA" Style="{StaticResource MilestoneHeaderStyle}" Foreground="{StaticResource MilestoneYellow}"/>

                            <!-- Row 1: Proceeding & Magistrate -->
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Header="Procedimento Penale" Text="{x:Bind ViewModel.CriminalProceeding, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="es. 12345/2023"/>
                                <TextBox Grid.Column="1" Header="Magistrato" Text="{x:Bind ViewModel.Magistrate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- Row 2: RIT/SPEC & Work ID -->
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Header="RIT/SPEC" Text="{x:Bind ViewModel.RitSpec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Column="1" Header="ID Lavoro (RCS)" Text="{x:Bind ViewModel.WorkId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- Row 3: Target & Password -->
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Header="Target" Text="{x:Bind ViewModel.Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <Grid Grid.Column="1" ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <PasswordBox Header="Password" Password="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Content="Genera" VerticalAlignment="Bottom" Grid.Column="1" Command="{x:Bind ViewModel.GeneratePasswordCommand}"/>
                                </Grid>
                            </Grid>

                            <!-- Row 4: Export Path -->
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                <TextBox Header="Cartella Esportazione" Text="{x:Bind ViewModel.ExportPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Content="Sfoglia" VerticalAlignment="Bottom" Grid.Column="1"/>
                            </Grid>

                        </StackPanel>
                    </Grid>
                </Border>

                <!-- FOOTER ACTION -->
                <Button Command="{x:Bind ViewModel.LaunchCommand}"
                        Background="{StaticResource MilestoneBlue}" Foreground="White"
                        HorizontalAlignment="Stretch" Height="56" CornerRadius="8" FontSize="18" FontWeight="Bold">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <SymbolIcon Symbol="Play"/>
                        <TextBlock Text="AVVIA ARCHIVIAZIONE"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
