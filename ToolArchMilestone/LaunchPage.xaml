<Page
    x:Class="ToolArchMilestone.LaunchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ToolArchMilestone.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Custom Segmented Pill Style for Config Toggles -->
        <Style x:Key="SegmentedPillStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#33FFFFFF"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="White"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MilestoneBlue}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="White"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetName="CheckIcon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="CheckIcon" Storyboard.TargetProperty="Width" To="16" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TextSecondary}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetName="CheckIcon" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="CheckIcon" Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Border x:Name="RootBorder" CornerRadius="18" BorderBrush="#333" BorderThickness="1" Background="Transparent">
                                <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <SymbolIcon x:Name="CheckIcon" Symbol="Accept" Foreground="White" Width="0" Opacity="0" Margin="0,0,4,0"/>
                                    <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Padding="32" Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content -->
        </Grid.RowDefinitions>

        <!-- === HEADER SECTION === -->
        <StackPanel Spacing="16" Margin="0,0,0,32">
            <StackPanel Spacing="4">
                <TextBlock Text="NUOVA ARCHIVIAZIONE" FontSize="32" FontWeight="Bold" Foreground="White" LetterSpacing="0.05"/>
                <TextBlock Text="Configura i parametri per avviare l'esportazione" FontSize="14" Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>

            <!-- Configuration Bar (Pill Group) -->
            <Border Background="#1E1E1E" CornerRadius="24" Padding="6" BorderBrush="#333" BorderThickness="1" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- Type Group -->
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="LEGALE" IsChecked="True" GroupName="Type" Style="{StaticResource SegmentedPillStyle}"/>
                        <RadioButton Content="DIGITALE" GroupName="Type" Style="{StaticResource SegmentedPillStyle}"/>
                    </StackPanel>

                    <Rectangle Width="1" Height="20" Fill="#444" Margin="4,0"/>

                    <!-- Source Group -->
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="SERVER" IsChecked="{x:Bind ViewModel.IsServer, Mode=TwoWay}" GroupName="Source" Style="{StaticResource SegmentedPillStyle}"/>
                        <RadioButton Content="ARCHIVIO" IsChecked="{x:Bind ViewModel.IsArchive, Mode=TwoWay}" GroupName="Source" Style="{StaticResource SegmentedPillStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- === SCROLLABLE CONTENT === -->
        <ScrollViewer Grid.Row="1" Padding="0,0,16,0">
            <StackPanel Spacing="24">

                <!-- CARD 1: SORGENTE -->
                <Border Style="{StaticResource MaterialCardStyle}">
                    <StackPanel Spacing="20">
                        <Grid>
                            <TextBlock Text="SORGENTE DATI" Style="{StaticResource MaterialHeaderStyle}"/>
                            <!-- Accent Line -->
                            <Rectangle Height="2" Width="40" Fill="{StaticResource MilestoneBlue}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,-8"/>
                        </Grid>

                        <!-- Server Config Section -->
                        <StackPanel Visibility="{x:Bind ViewModel.IsServer, Mode=OneWay, Converter={StaticResource BoolToVis}}" Spacing="16">

                            <!-- Server Address Field (Compound) -->
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel>
                                    <TextBlock Text="Indirizzo Server" Style="{StaticResource InputLabelStyle}"/>
                                    <Grid>
                                        <TextBox Style="{StaticResource MaterialTextBoxStyle}" Text="{x:Bind ViewModel.ServerAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="es. 192.168.1.100"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Button Content="Connetti" Style="{StaticResource MaterialSecondaryButtonStyle}" Height="32" FontSize="12" Margin="0,0,4,0"/>
                                            <Button Style="{StaticResource MaterialIconButtonStyle}" Command="{x:Bind ViewModel.PinFieldCommand}" CommandParameter="ServerAddress" ToolTipService.ToolTip="Fissa Valore">
                                                <SymbolIcon Symbol="Pin" FontSize="14"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Camera Field (Compound) -->
                            <StackPanel>
                                <TextBlock Text="Telecamera Selezionata" Style="{StaticResource InputLabelStyle}"/>
                                <Grid>
                                    <TextBox Style="{StaticResource MaterialTextBoxStyle}" Text="{x:Bind ViewModel.CameraName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" PlaceholderText="Nessuna selezione..."/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Button Content="Seleziona" Style="{StaticResource MaterialSecondaryButtonStyle}" Height="32" FontSize="12" Margin="0,0,4,0"/>
                                        <Button Style="{StaticResource MaterialIconButtonStyle}" Command="{x:Bind ViewModel.PinFieldCommand}" CommandParameter="CameraName" ToolTipService.ToolTip="Fissa Valore">
                                            <SymbolIcon Symbol="Pin" FontSize="14"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- Interval Section -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/> <!-- Date Inputs -->
                                <ColumnDefinition Width="1*"/> <!-- Drop Area -->
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Start Date -->
                                    <StackPanel>
                                        <TextBlock Text="Inizio (dd/MM/yyyy HH:mm)" Style="{StaticResource InputLabelStyle}"/>
                                        <Grid>
                                            <TextBox Style="{StaticResource MaterialTextBoxStyle}" Text="{x:Bind ViewModel.StartDateString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind ViewModel.IsManualIntervalEnabled, Mode=OneWay}"/>
                                            <Button Style="{StaticResource MaterialIconButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                                                <SymbolIcon Symbol="Calendar" Foreground="{StaticResource MilestoneBlue}"/>
                                                <Button.Flyout>
                                                    <Flyout>
                                                        <StackPanel Spacing="8">
                                                            <CalendarDatePicker DateChanged="StartPicker_DateChanged" Date="{x:Bind ViewModel.StartTime, Mode=TwoWay, Converter={StaticResource DateToOffset}}"/>
                                                            <TimePicker TimeChanged="StartTime_TimeChanged" SelectedTime="{x:Bind ViewModel.StartTimeTime, Mode=TwoWay}" ClockIdentifier="24HourClock"/>
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <!-- End Date -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Fine (dd/MM/yyyy HH:mm)" Style="{StaticResource InputLabelStyle}"/>
                                        <Grid>
                                            <TextBox Style="{StaticResource MaterialTextBoxStyle}" Text="{x:Bind ViewModel.EndDateString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind ViewModel.IsManualIntervalEnabled, Mode=OneWay}"/>
                                            <Button Style="{StaticResource MaterialIconButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                                                <SymbolIcon Symbol="Calendar" Foreground="{StaticResource MilestoneBlue}"/>
                                                <Button.Flyout>
                                                    <Flyout>
                                                        <StackPanel Spacing="8">
                                                            <CalendarDatePicker DateChanged="EndPicker_DateChanged" Date="{x:Bind ViewModel.EndTime, Mode=TwoWay, Converter={StaticResource DateToOffset}}"/>
                                                            <TimePicker TimeChanged="EndTime_TimeChanged" SelectedTime="{x:Bind ViewModel.EndTimeTime, Mode=TwoWay}" ClockIdentifier="24HourClock"/>
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <CheckBox Content="Separa archiviazioni per intervallo" IsChecked="{x:Bind ViewModel.SeparateArchive, Mode=TwoWay}" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>

                            <!-- Custom Drop Area -->
                            <Grid Grid.Column="1" AllowDrop="True" DragOver="DropArea_DragOver" Drop="DropArea_Drop">
                                <Border Background="#252525" BorderBrush="#444" BorderThickness="1" CornerRadius="8" StrokeDashArray="4,4"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                    <Viewbox Width="32" Height="32">
                                        <SymbolIcon Symbol="Document" Foreground="{StaticResource MilestoneBlue}"/>
                                    </Viewbox>
                                    <TextBlock Text="Trascina TXT qui" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>

                                    <!-- Import Actions -->
                                    <Button Content="Sfoglia..." Command="{x:Bind ViewModel.ImportIntervalsFromFileCommand}" Style="{StaticResource MaterialSecondaryButtonStyle}" Height="32" FontSize="12"/>

                                    <!-- Imported File Indicator -->
                                    <StackPanel Orientation="Horizontal" Visibility="{x:Bind ViewModel.IsFileImported, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                Background="#334433" Padding="8,4" CornerRadius="12" HorizontalAlignment="Center" Spacing="6" Margin="0,8,0,0">
                                        <SymbolIcon Symbol="Check" Foreground="#4CAF50" FontSize="12"/>
                                        <TextBlock Text="{x:Bind ViewModel.ImportedFileName, Mode=OneWay}" FontSize="11" Foreground="#81C784" FontWeight="Bold" MaxWidth="80" TextTrimming="CharacterEllipsis"/>
                                        <Button Background="Transparent" Padding="0" Width="16" Height="16" Command="{x:Bind ViewModel.RemoveImportedFileCommand}">
                                            <SymbolIcon Symbol="Cancel" Foreground="#E57373" FontSize="12"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CARD 2: DATI PROCEDURA -->
                <Border Style="{StaticResource MaterialCardStyle}">
                    <StackPanel Spacing="20">
                        <Grid>
                            <TextBlock Text="DATI PROCEDURA" Style="{StaticResource MaterialHeaderStyle}" Foreground="{StaticResource MilestoneYellow}"/>
                            <!-- Accent Line -->
                            <Rectangle Height="2" Width="40" Fill="{StaticResource MilestoneYellow}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,-8"/>
                        </Grid>

                        <Grid ColumnSpacing="16" RowSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 1 -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Procedimento Penale" Style="{StaticResource InputLabelStyle}"/>
                                <TextBox Style="{StaticResource MaterialTextBoxStyle}" Text="{x:Bind ViewModel.CriminalProceeding, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="12345/2023"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="Magistrato" Style="{StaticResource InputLabelStyle}"/>
                                <TextBox Style="{StaticResource MaterialTextBoxStyle}" Text="{x:Bind ViewModel.Magistrate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Row 2 -->
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="RIT / SPEC" Style="{StaticResource InputLabelStyle}"/>
                                <TextBox Style="{StaticResource MaterialTextBoxStyle}" Text="{x:Bind ViewModel.RitSpec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="ID Lavoro (RCS)" Style="{StaticResource InputLabelStyle}"/>
                                <TextBox Style="{StaticResource MaterialTextBoxStyle}" Text="{x:Bind ViewModel.WorkId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Row 3 -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Target" Style="{StaticResource InputLabelStyle}"/>
                                <TextBox Style="{StaticResource MaterialTextBoxStyle}" Text="{x:Bind ViewModel.Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Password with Actions -->
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <TextBlock Text="Password" Style="{StaticResource InputLabelStyle}"/>
                                <Grid>
                                    <TextBox Style="{StaticResource MaterialTextBoxStyle}" Text="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Button Content="Genera" Command="{x:Bind ViewModel.GeneratePasswordCommand}" Style="{StaticResource MaterialSecondaryButtonStyle}" Height="32" FontSize="12" Margin="0,0,4,0"/>
                                        <Button Style="{StaticResource MaterialIconButtonStyle}" Command="{x:Bind ViewModel.PinFieldCommand}" CommandParameter="Password" ToolTipService.ToolTip="Fissa Valore">
                                            <SymbolIcon Symbol="Pin" FontSize="14"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Row 4: Export Path -->
                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
                                <TextBlock Text="Cartella di Esportazione" Style="{StaticResource InputLabelStyle}"/>
                                <Grid>
                                    <TextBox Style="{StaticResource MaterialTextBoxStyle}" Text="{x:Bind ViewModel.ExportPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Button Content="Sfoglia" Style="{StaticResource MaterialSecondaryButtonStyle}" Height="32" FontSize="12" Margin="0,0,4,0"/>
                                        <Button Style="{StaticResource MaterialIconButtonStyle}" Command="{x:Bind ViewModel.PinFieldCommand}" CommandParameter="ExportPath" ToolTipService.ToolTip="Fissa Valore">
                                            <SymbolIcon Symbol="Pin" FontSize="14"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- MAIN ACTION -->
                <Button Command="{x:Bind ViewModel.LaunchCommand}" Style="{StaticResource MaterialPrimaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,16,0,32">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <SymbolIcon Symbol="Play" Foreground="White"/>
                        <TextBlock Text="AVVIA ARCHIVIAZIONE" Foreground="White"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
