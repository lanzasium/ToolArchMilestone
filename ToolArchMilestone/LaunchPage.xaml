<Page
    x:Class="ToolArchMilestone.LaunchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ToolArchMilestone.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:DateTimeToDateTimeOffsetConverter x:Key="DateToOffset"/>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Spacing="20" Padding="20">
            <TextBlock Text="Nuova Archiviazione" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- Type Selection -->
            <StackPanel Orientation="Horizontal" Spacing="20">
                <TextBlock Text="Tipo:" VerticalAlignment="Center" FontWeight="Bold"/>
                <RadioButton Content="Legale" IsChecked="True" GroupName="Type" />
                <RadioButton Content="Digitale" GroupName="Type" />
            </StackPanel>

            <!-- Source Selection -->
            <StackPanel Orientation="Horizontal" Spacing="20">
                <TextBlock Text="Sorgente:" VerticalAlignment="Center" FontWeight="Bold"/>
                <RadioButton Content="Da Server" IsChecked="{x:Bind ViewModel.IsServer, Mode=OneWay}" GroupName="Source" />
                <RadioButton Content="Da Archivio" IsChecked="{x:Bind ViewModel.IsArchive, Mode=OneWay}" GroupName="Source" />
            </StackPanel>

            <!-- Server Section -->
            <StackPanel Visibility="{x:Bind ViewModel.IsServer, Mode=OneWay, Converter={StaticResource BoolToVis}}" Spacing="10" BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="1" Padding="10" CornerRadius="4">
                <TextBlock Text="Dati Server" Style="{StaticResource SubtitleTextBlockStyle}" />

                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10">
                    <TextBox Header="Indirizzo Server" Text="{x:Bind ViewModel.ServerAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="es. 192.168.1.100"/>
                    <Button Content="Connetti" VerticalAlignment="Bottom" Grid.Column="1"/>
                    <Button Content="📌" VerticalAlignment="Bottom" Grid.Column="2"/>
                </Grid>

                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                    <TextBox Header="Telecamera" Text="{x:Bind ViewModel.CameraName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" PlaceholderText="Seleziona camera..."/>
                    <Button Content="Seleziona" VerticalAlignment="Bottom" Grid.Column="1"/>
                </Grid>

                <TextBlock Text="Intervallo Temporale" FontWeight="SemiBold" Margin="0,10,0,0"/>
                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                    <DatePicker Header="Inizio" Date="{x:Bind ViewModel.StartTime, Mode=TwoWay, Converter={StaticResource DateToOffset}}"/>
                    <DatePicker Header="Fine" Date="{x:Bind ViewModel.EndTime, Mode=TwoWay, Converter={StaticResource DateToOffset}}"/>
                </Grid>

                <TextBlock Text="Importazione Multipla (TXT)" FontWeight="SemiBold"/>
                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10">
                    <TextBox PlaceholderText="Incolla o carica file..." Text="{x:Bind ViewModel.IntervalsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60"/>
                    <Button Content="Carica TXT" VerticalAlignment="Top" Grid.Column="1" Command="{x:Bind ViewModel.ImportIntervalsFromFileCommand}"/>
                    <Button Content="Rimuovi" VerticalAlignment="Top" Grid.Column="2"/>
                </Grid>
            </StackPanel>

            <!-- Common Section -->
            <StackPanel Spacing="10">
                 <TextBlock Text="Dati Procedura" Style="{StaticResource SubtitleTextBlockStyle}" />
                 <TextBox Header="Procedimento Penale" Text="{x:Bind ViewModel.CriminalProceeding, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                 <TextBox Header="Magistrato" Text="{x:Bind ViewModel.Magistrate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                 <TextBox Header="RIT/SPEC" Text="{x:Bind ViewModel.RitSpec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                 <TextBox Header="ID Lavoro (Fatturazione)" Text="{x:Bind ViewModel.WorkId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                 <TextBox Header="Target" Text="{x:Bind ViewModel.Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                 <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10">
                     <TextBox Header="Password" Text="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                     <Button Content="Genera" VerticalAlignment="Bottom" Grid.Column="1" Command="{x:Bind ViewModel.GeneratePasswordCommand}"/>
                     <Button Content="📌" VerticalAlignment="Bottom" Grid.Column="2"/>
                 </Grid>

                 <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10">
                     <TextBox Header="Cartella Esportazione" Text="{x:Bind ViewModel.ExportPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                     <Button Content="Sfoglia" VerticalAlignment="Bottom" Grid.Column="1"/>
                     <Button Content="📌" VerticalAlignment="Bottom" Grid.Column="2"/>
                 </Grid>
            </StackPanel>

            <Button Content="LANCIA ARCHIVIAZIONE" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.LaunchCommand}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
