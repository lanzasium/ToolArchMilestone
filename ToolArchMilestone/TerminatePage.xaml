<Page
    x:Name="RootPage"
    x:Class="ToolArchMilestone.TerminatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:core="using:ToolArchMilestone.Core.Models"
    mc:Ignorable="d">

    <Grid Padding="24" Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="2" Margin="0,0,0,16">
            <TextBlock Text="ARCHIVIAZIONI TERMINATE" FontSize="24" FontWeight="Bold" Foreground="White" CharacterSpacing="30"/>
            <TextBlock Text="Storico delle esportazioni completate o fallite" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
        </StackPanel>

        <!-- Search Bar -->
        <TextBox Grid.Row="1"
                 Style="{StaticResource MaterialTextBoxStyle}"
                 PlaceholderText="Cerca per ID Job, ID Lavoro, Camera, Target..."
                 Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,16"/>

        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Jobs, Mode=OneWay}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="core:ArchivingJob">
                    <Border Style="{StaticResource MaterialCardStyle}" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Job Info -->
                            <StackPanel Orientation="Vertical" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <!-- Status Chip -->
                                    <Border Background="#22FFFFFF" CornerRadius="10" Padding="8,2">
                                        <TextBlock Text="{x:Bind Status}" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- ID -->
                                    <TextBlock Text="{x:Bind DisplayId}" FontWeight="Bold" Foreground="{StaticResource MilestoneBlue}" VerticalAlignment="Center" FontSize="13"/>

                                    <TextBlock Text="{x:Bind WorkId}" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" FontSize="13"/>
                                    <TextBlock Text="|" Foreground="Gray" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind CameraName}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0,0,0">
                                    <FontIcon Glyph="&#xE787;" FontFamily="{ThemeResource SymbolThemeFontFamily}" Foreground="Gray" FontSize="11"/>
                                    <TextBlock Text="{x:Bind StartTime}" Foreground="Gray" FontSize="12"/>
                                    <FontIcon Glyph="&#xE72A;" FontFamily="{ThemeResource SymbolThemeFontFamily}" Foreground="Gray" FontSize="11"/> <!-- Forward Arrow -->
                                    <TextBlock Text="{x:Bind EndTime}" Foreground="Gray" FontSize="12"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0,0,0">
                                    <FontIcon Glyph="&#xE8B7;" FontFamily="{ThemeResource SymbolThemeFontFamily}" Foreground="Gray" FontSize="11"/> <!-- Folder -->
                                    <TextBlock Text="{x:Bind ExportPath}" FontSize="11" Foreground="#666666" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Controls -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Content="Dettagli" Style="{StaticResource MaterialSecondaryButtonStyle}" Height="28" FontSize="11">
                                     <Button.Flyout>
                                         <Flyout>
                                             <StackPanel Width="320" Spacing="8">
                                                 <TextBlock Text="DETTAGLI STORICO" Style="{StaticResource MaterialHeaderStyle}"/>
                                                 <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                                                     <TextBlock Text="ID Lavoro:" Foreground="Gray"/> <TextBlock Grid.Column="1" Text="{x:Bind WorkId}" Margin="8,0,0,0"/>
                                                     <TextBlock Grid.Row="1" Text="Proc.:" Foreground="Gray"/> <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind CriminalProceeding}" Margin="8,0,0,0"/>
                                                     <TextBlock Grid.Row="2" Text="Target:" Foreground="Gray"/> <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind Target}" Margin="8,0,0,0"/>
                                                     <TextBlock Grid.Row="3" Text="File:" Foreground="Gray"/> <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind GeneratedFilePath}" TextWrapping="Wrap" Margin="8,0,0,0" FontStyle="Italic"/>
                                                 </Grid>

                                                 <TextBlock Text="LOG DI SISTEMA" Style="{StaticResource MaterialHeaderStyle}" Margin="0,12,0,0" FontSize="12"/>
                                                 <ListView ItemsSource="{x:Bind Logs}" Height="150">
                                                     <ListView.ItemTemplate>
                                                         <DataTemplate>
                                                             <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap" Foreground="White"/>
                                                         </DataTemplate>
                                                     </ListView.ItemTemplate>
                                                 </ListView>
                                             </StackPanel>
                                         </Flyout>
                                     </Button.Flyout>
                                </Button>

                                <Button Content="Elimina" VerticalAlignment="Center"
                                        Style="{StaticResource MaterialSecondaryButtonStyle}" Foreground="#EF5350" BorderBrush="#EF5350"
                                        Height="28" FontSize="11"
                                        Command="{Binding ElementName=RootPage, Path=ViewModel.DeleteJobCommand}"
                                        CommandParameter="{x:Bind Id}"/>

                                <Button Content="Elimina + File" VerticalAlignment="Center"
                                        Background="#E53935" Foreground="White" CornerRadius="14" BorderThickness="0"
                                        Padding="12,0" Height="28" FontSize="11"
                                        Command="{Binding ElementName=RootPage, Path=ViewModel.DeleteJobWithFileCommand}"
                                        CommandParameter="{x:Bind Id}"/>

                                <Button Content="Crea SIT" VerticalAlignment="Center"
                                        Style="{StaticResource MaterialSecondaryButtonStyle}"
                                        Height="28" FontSize="11"
                                        Command="{Binding ElementName=RootPage, Path=ViewModel.CreateSitCommand}"
                                        CommandParameter="{x:Bind Id}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
